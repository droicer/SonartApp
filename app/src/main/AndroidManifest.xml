<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />



    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sonart"
        tools:targetApi="31">

        <service
            android:name=".service.MusicService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />


        <activity
            android:name=".view.Song.PlaySongActivity"
            android:exported="false" />
        <activity
            android:name=".view.Song.EditSongActivity"
            android:exported="false" />
        <activity
            android:name=".view.Song.MySongActivity"
            android:exported="false" />
        <activity
            android:name=".view.Song.CreateSongActivity"
            android:exported="false" />
        <activity
            android:name=".view.Artist.ArtistActivity"
            android:exported="false"
            android:theme="@style/Theme.Sonart" />
        <activity
            android:name=".view.Artist.EditProfileArtistActivity"
            android:exported="false"
            android:theme="@style/Theme.Sonart" />
        <activity
            android:name=".view.Artist.CreateArtistActivity"
            android:exported="false"
            android:theme="@style/Theme.Sonart" />
        <activity
            android:name=".view.User.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Sonart" />
        <activity
            android:name=".view.User.MenuActivity"
            android:exported="false" />
        <activity
            android:name=".view.RecoverPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".view.Login.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".view.Login.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".view.Login.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Sonart">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>